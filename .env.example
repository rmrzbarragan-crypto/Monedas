# Copia este archivo como ".env.local" y llena los valores.
# ".env.local" NUNCA se sube a GitHub (está en .gitignore).
# En Vercel, estos mismos valores van en: Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API Keys → "Publishable key" (empieza con sb_publishable_)
# Esta clave es pública por diseño: la protección real la dan el login y RLS.
# NUNCA pongas aquí la "Secret key" (sb_secret_...) ni la "service_role".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
